    {
      "name": "01 · POST /auth/register (201/400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Usuario Postman Taller\", \"email\": \"taller.postman.u2@example.com\", \"password\": \"Taller2026!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Datos distintos en cada corrida; ninguna colisión de código entre pruebas.",
              "const letras = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";",
              "let codigo = \"\";",
              "for (let i=0;i<3;i++) codigo += letras[Math.floor(Math.random()*letras.length)];",
              "codigo += \"-\" + String(Math.floor(Math.random()*100)).padStart(2,\"0\");",
              "pm.collectionVariables.set(\"codigoPrueba\", codigo);",
              "pm.collectionVariables.set(\"nombrePrueba\", \"Revision de taller \" + Date.now());",
              "pm.collectionVariables.unset(\"token\");",
              "pm.collectionVariables.unset(\"servicioId\");",
              "pm.collectionVariables.unset(\"ordenId\");",
              "pm.collectionVariables.unset(\"bitacoraId\");",
              "pm.collectionVariables.unset(\"tokenOtro\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registro inicial o usuario ya registrado\", () => pm.expect([201,400]).to.include(pm.response.code));",
              "pm.test(\"El registro responde JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
