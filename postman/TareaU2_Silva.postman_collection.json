    {
      "name": "04 · POST /servicios (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/servicios",
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"{{nombrePrueba}}\", \"codigo\": \"{{codigoPrueba}}\", \"categoria\": \"mantenimiento\", \"tiempoEstimadoMin\": 45, \"repuestos\": [\"Aceite\", \"Filtro\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const d=pm.response.json();",
              "pm.test(\"Generó ObjectId\", () => pm.expect(d._id).to.match(/^[a-f0-9]{24}$/i));",
              "pm.test(\"Repuestos embebidos\", () => pm.expect(d.repuestos).to.include(\"Aceite\"));",
              "pm.test(\"Slug automático\", () => pm.expect(d.slug).to.be.a(\"string\").and.not.empty);",
              "pm.collectionVariables.set(\"servicioId\",d._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 · GET /servicios (filtros)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/servicios?q=Revision&fields=nombre,codigo&sort=-nombre"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const x=pm.response.json();",
              "const actual=x.find(s=>s._id===pm.collectionVariables.get(\"servicioId\"));",
              "pm.test(\"Búsqueda encuentra el servicio\", () => pm.expect(actual).to.exist);",
              "pm.test(\"Proyección incluye código\", () => pm.expect(actual.codigo).to.eql(pm.collectionVariables.get(\"codigoPrueba\")));",
              "pm.test(\"Proyección excluye categoría\", () => pm.expect(actual).not.to.have.property(\"categoria\"));"
            ]
          }
        }
      ]
    },
