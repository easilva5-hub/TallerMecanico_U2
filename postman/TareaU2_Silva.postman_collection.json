              "pm.test(\"Unió servicio desde MongoDB\", () => pm.expect(orden.servicio._id).to.eql(pm.collectionVariables.get(\"servicioId\")));",
              "pm.test(\"No hace falta N+1 para listado\", () => pm.expect(orden.servicio.nombre).to.eql(\"Cambio de aceite verificado\"));"
            ]
