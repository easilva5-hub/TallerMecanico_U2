              "const d=pm.response.json();",
              "pm.test(\"Nombre actualizado\", () => pm.expect(d.nombre).to.eql(\"Cambio de aceite verificado\"));",
              "pm.test(\"Slug recalculado por pre validate\", () => pm.expect(d.slug).to.eql(\"cambio-de-aceite-verificado\"));",
              "pm.test(\"Duración actualizada\", () => pm.expect(d.tiempoEstimadoMin).to.eql(60));"
            ]
